---
import '../styles/global.css';
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>WanDigi | The Agentic Local Growth System</title>
	</head>
	<body class="bg-slate-50 min-h-screen flex items-center justify-center">
		<div class="text-center">
			<!-- Perhatikan kita membuang class text-wandigi-blue dan font-bold karena sudah diatur otomatis di global.css -->
			<h1 class="text-4xl mb-4">Infrastruktur WanDigi Aktif</h1>
			<p class="text-lg text-slate-600 mb-6">Don't just rank. Be the answer and the action.</p>
			<button class="px-6 py-3 bg-wandigi-orange text-white font-semibold rounded-lg shadow-md hover:bg-orange-600 transition-colors">
				Free Audit Dummy
			</button>
		</div>
	</body>
</html>