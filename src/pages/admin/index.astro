---
// src/pages/admin/index.astro
import '../../styles/global.css';
import { supabase } from '../../lib/supabase';

let errorMessage = "";

// Cek apakah ada request POST dari form login
if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const email = data.get("email")?.toString();
    const password = data.get("password")?.toString();

    if (email && password) {
      // 1. Melakukan login ke Supabase
      const { data: authData, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        errorMessage = "Kredensial salah atau tidak terdaftar.";
      } else {
        // 2. Set Cookies untuk sesi (Supabase menggunakan access_token & refresh_token)
        const { access_token, refresh_token } = authData.session;
        Astro.cookies.set("sb-access-token", access_token, { path: "/", httpOnly: true, secure: true });
        Astro.cookies.set("sb-refresh-token", refresh_token, { path: "/", httpOnly: true, secure: true });

        // 3. Redirect ke dashboard admin setelah berhasil login
        return Astro.redirect("/admin/dashboard");
      }
    }
  } catch (error) {
    errorMessage = "Terjadi kesalahan sistem. Silakan coba lagi.";
  }
}
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<title>Login Admin | Ruang Kendali WanDigi</title>
	</head>
	<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4">
		<div class="w-full max-w-md">
			<div class="flex justify-center mb-8">
				<img src="/wandigi-seo-logo.webp" alt="WanDigi Logo" class="h-12 w-auto" />
			</div>

			<div class="bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden">
				<div class="p-8">
					<div class="mb-8">
						<h1 class="text-2xl font-bold text-wandigi-blue mb-2">Ruang Kendali</h1>
						<p class="text-slate-500 text-sm">Otorisasi akses sistem Agentic Layer</p>
					</div>

					{errorMessage && (
						<div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 text-sm">
							{errorMessage}
						</div>
					)}

					<!-- Tambahkan method="POST" pada form -->
					<form method="POST" class="space-y-6">
						<div class="mb-5">
							<label for="email" class="block text-sm font-semibold text-slate-700 mb-2">Kredensial Email</label>
							<input 
								type="email" 
								id="email" 
								name="email" 
								placeholder="admin@wandigi.com"
								class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-wandigi-blue focus:border-wandigi-blue outline-none transition-all"
								required
							/>
						</div>

						<div class="mb-5">
							<label for="password" class="block text-sm font-semibold text-slate-700 mb-2">Kata Sandi</label>
							<input 
								type="password" 
								id="password" 
								name="password" 
								class="w-full px-4 py-3 rounded-lg border border-slate-200 focus:ring-2 focus:ring-wandigi-blue focus:border-wandigi-blue outline-none transition-all"
								required
							/>
						</div>

						<button 
							type="submit" 
							class="w-full bg-wandigi-orange hover:bg-orange-600 text-white font-bold py-3.5 rounded-lg shadow-lg shadow-orange-200 transition-all transform active:scale-[0.98]"
						>
							Aktivasi Sesi Admin
						</button>
					</form>
				</div>
				
				<div class="bg-slate-50 px-8 py-4 border-t border-slate-100 text-center">
					<p class="text-xs text-slate-400 font-medium uppercase tracking-widest">WanDigi Security Protocol</p>
				</div>
			</div>

			<div class="text-center mt-6">
				<a href="/" class="text-sm text-slate-400 hover:text-wandigi-blue transition-colors font-medium">
					&larr; Kembali ke Situs Utama
				</a>
			</div>
		</div>
	</body>
</html>