---
// Memaksa mesin Astro untuk memproses halaman ini di server (SSR), bukan HTML statis.
// Ini adalah syarat mutlak untuk membangun proteksi sesi privat.
export const prerender = false;

// Nanti kita akan mengimpor supabase di sini untuk logika login
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Admin | WanDigi CMS</title>
  </head>
  <body class="bg-gray-50 flex items-center justify-center min-h-screen font-sans text-gray-800">
    
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md border border-gray-100">
      <!-- Penggunaan warna utama #053280 sesuai spesifikasi desain UI -->
      <h1 class="text-2xl font-bold text-wandigi-blue mb-2 text-center">Ruang Kendali WanDigi</h1>
      <p class="text-sm text-gray-500 text-center mb-8">Akses otorisasi untuk The Agentic Layer</p>
      
      <form class="flex flex-col gap-5">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Kredensial Email</label>
          <!-- Focus state menggunakan warna oranye #FC6701 untuk Conversion Trigger visual -->
          <input type="email" class="w-full border border-gray-300 rounded px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-wandigi-orange focus:border-transparent transition-all" placeholder="admin@wandigi.com" required />
        </div>
        
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Kata Sandi</label>
          <input type="password" class="w-full border border-gray-300 rounded px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-wandigi-orange focus:border-transparent transition-all" required />
        </div>
        
        <button type="submit" class="w-full bg-wandigi-orange text-white font-bold py-3 px-4 rounded mt-4 hover:bg-[#e05b00] transition-colors shadow-sm">
          Aktivasi Sesi Admin
        </button>
      </form>
    </div>

  </body>
</html>