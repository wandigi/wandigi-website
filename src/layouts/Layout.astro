---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
}

const { 
	title, 
	description = "WanDigi - The Agentic Local Growth System. Customer Acquisition Partner untuk bisnis jasa lokal." 
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/wandigi-seo-logo-favicon.webp" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body class="bg-slate-50 flex flex-col min-h-screen">
		
		<!-- Panggil komponen Navbar -->
		<Navbar />

		<main class="grow">
			<slot />
		</main>

		<!-- Panggil komponen Footer -->
		<Footer />
		
	</body>
</html>